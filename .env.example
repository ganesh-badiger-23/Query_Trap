# ========================================================
# Query Trap (Sentinel DB) - Environment Configuration
# ========================================================

# Deployment role: 'unified' (default), 'sentinel', 'storefront', or 'honeypot'
# In 'unified' mode, a single instance serves dashboard (/), storefront (/portal), and honeypot (/honeypot).
SERVICE_ROLE=unified

# Server network settings
PORT=5100
HOST=0.0.0.0

# Security secret key for session encryption
SECRET_KEY=change-this-to-a-secure-random-string

# Allowed origins for CORS (comma-separated, or '*' to allow all)
ALLOWED_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# Custom external URLs for multi-service or custom domain deployments:
# SENTINEL_URL=https://soc.example.com/
# STOREFRONT_URL=https://shop.example.com/
# HONEYPOT_URL=https://decoy.example.com/

# Path to SQLite data directory
QUERY_TRAP_DATA=data

# Production Gunicorn concurrency settings (Linux/Docker)
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

